<idea-plugin>
    <id>edu.unc.learnwithai</id>
    <name>LearnWithAI</name>
    <vendor>ThreadMind Course Staff</vendor>
    <description><![CDATA[
        Opens <b>learnwithai.unc.edu</b> in a sidebar inside IntelliJ, so you can use
        the course site next to your code. Click <b>LearnWithAI</b> on the right edge
        of the window and sign in with your UNC account.
    ]]></description>
    <depends>com.intellij.modules.platform</depends>
    <!-- IntelliJ 2026.2+ ships the embedded browser (JCEF) as a separate bundled
         plugin; its classes are only visible to plugins that depend on it. Older
         IDEs have no such plugin and keep JCEF in the core, so this is optional. -->
    <depends optional="true" config-file="learnwithai-jcef.xml">com.intellij.modules.jcef</depends>
    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="LearnWithAI"
                    anchor="right"
                    icon="/icons/learnwithai.svg"
                    factoryClass="edu.unc.learnwithai.LearnWithAIToolWindowFactory"/>
    </extensions>
</idea-plugin>
